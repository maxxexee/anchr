# Sepolia RPC endpoint used by the deploy scripts and the e2e runs.
SEPOLIA_RPC_URL=

# Deployer key for script/DeployAnchr.s.sol and script/DeployVault.s.sol.
# Use a throwaway testnet key. Never commit a funded key.
PRIVATE_KEY=

# Deployed AnchrAnchorRegistry address used by e2e-test.mjs.
ANCHOR_ADDRESS=

# Local anvil runs use the public default account 0 key, so this is optional.
ANVIL_PRIVATE_KEY=
